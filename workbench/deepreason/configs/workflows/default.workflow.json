      "handler": "intake",
      "checkpoint": false,
      "gate_policy": {},
      "ui": {}
    },
    {
      "id": "plan",
      "label": "计划",
      "agent": "planner",
      "description": "生成可审计的推理计划",
      "work": "根据路由和 reviewer 审查生成可执行计划。",
      "input_contract": "规范化目标",
      "output_contract": "计划步骤",
