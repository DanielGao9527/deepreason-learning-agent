      "input_contract": "证据审计结果",
      "output_contract": "门禁决策",
      "handler_kind": "builtin",
      "handler": "gate",
      "checkpoint": true,
      "gate_policy": {
        "approval_action": "answer",
        "risk": "dynamic"
      },
      "ui": {}
    },
    {
