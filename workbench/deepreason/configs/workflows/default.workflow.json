      "output_contract": "可发布结果",
      "handler_kind": "builtin",
      "handler": "act_or_answer",
      "checkpoint": false,
      "gate_policy": {},
      "ui": {}
    },
    {
      "id": "verify",
      "label": "验证",
      "agent": "critic",
      "description": "验证状态、证据和输出一致性",
      "work": "检查输出、门禁和证据状态是否一致。",
      "input_contract": "可发布结果",
      "output_contract": "验证记录",
      "handler_kind": "builtin",
      "handler": "verify",
      "checkpoint": true,
      "gate_policy": {},
      "ui": {}
    },
    {
      "id": "consolidate",
      "label": "沉淀",
      "agent": "memory",
      "description": "只生成记忆/演进候选，不直接写保护资产",
